{
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "helm",
      "managerFilePatterns": ["**/modules/apps/**/*.nix"],
      "matchStrings": [
        "charts\\.[\\w-]+\\s*=\\s*\\{\\s*repo\\s*=\\s*\"(?<registryUrl>https://[^\"]+)\";\\s*chart\\s*=\\s*\"(?<depName>[^\"]+)\";\\s*version\\s*=\\s*\"(?<currentValue>[^\"]+)\";"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["**/modules/apps/**/*.nix"],
      "matchStrings": [
        "charts\\.[\\w-]+\\s*=\\s*\\{\\s*repo\\s*=\\s*\"oci://(?<registry>[^\"]+)\";\\s*chart\\s*=\\s*\"(?<depName>[^\"]+)\";\\s*version\\s*=\\s*\"(?<currentValue>[^\"]+)\";"
      ],
      "packageNameTemplate": "{{registry}}/{{depName}}"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["**/modules/apps/**/*.nix"],
      "postUpgradeTasks": {
        "commands": [
          "nix run github:scareyo/homelab#update-hash {{{packageFile}}}",
          "nix run github:scareyo/homelab#generate-manifests"
        ],
        "executionMode": "update"
      }
    },
    {
      "description": "v2.2.x predates the v1.0.0 version reset",
      "matchDepNames": ["agentgateway", "agentgateway-crds"],
      "allowedVersions": "<2"
    }
  ],
  "prHourlyLimit": 16,
  "dependencyDashboard": true
}
